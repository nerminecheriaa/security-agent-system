# Required — Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Optional — Groq model (default: openai/gpt-oss-20b, see https://console.groq.com/docs/models)
GROQ_MODEL=

# Optional — NVD API key for higher rate limits (https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=

# Optional — API URL used by the Streamlit UI (default: http://localhost:8000)
# Note: the UI does not read this file; set API_URL in the UI terminal's environment instead.
# API_URL=http://localhost:8000
